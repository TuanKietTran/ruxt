# Database (Neon serverless PostgreSQL — required for Deno Deploy)
# Get from: https://neon.tech → project → connection string (pooled)
DATABASE_URL=

# Force Node.js server preset for local Docker / on-prem builds
# Leave unset for Deno Deploy (default)
# NITRO_PRESET=node-server

# Authentication
# Local development uses a matching Clerk development-key pair. On Deno Deploy,
# configure these names in both contexts: pk_live_/sk_live_ in Production and
# pk_test_/sk_test_ in Development (Preview and Git Branch timelines).
# The secret key and session secret are server-only.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
NUXT_CLERK_SECRET_KEY=sk_test_replace-me

# Retained for legacy email/password sessions during the Clerk migration.
# Use a different random value in every deployed Deno context.
NUXT_SESSION_SECRET=replace-with-at-least-32-random-characters

# Feature policy is deployment-owned; no host or route rule is hard-coded.
# Values are comma-separated. Host entries may be exact or wildcard subdomains;
# route entries are exact unless they end in /**.
NUXT_PUBLIC_FEATURE_FLAGS_AUTH_DISABLED_HOSTS=*.deno.net
NUXT_PUBLIC_FEATURE_FLAGS_AUTH_ROUTES=/login,/settings/**,/d/**,/api/auth/**,/api/cloud-data/**,/api/cv-imports/**,/api/cv-applications/**,/api/cv-artifacts/**,/api/cv-templates/**,/api/cv-capabilities

# CV storage
# CV_DATA_DIR=./.data/cv
# CV_PIPELINE_DATA_DIR=./.data/cv-pipeline
# Hourly aggregate metrics consumed by the separately deployed admin workspace.
# ANALYTICS_DATA_DIR=./.data/analytics

# Server-side PDF/image import
# Run `pnpm cv:pipeline:setup` for the default local Python path.
# CV_PIPELINE_PYTHON=./.data/cv-pipeline-venv/bin/python
# CV_PIPELINE_DIR=./server/pipeline
# CV_IMPORT_MAX_BYTES=15728640
# CV_ARTIFACT_TTL_HOURS=24
