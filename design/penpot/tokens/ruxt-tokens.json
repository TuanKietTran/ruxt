        "pink": "#f472b6",
        "mauve": "#a78bfa",
        "red": "#f87171",
        "peach": "#fb923c",
        "yellow": "#fbbf24",
        "green": "#4ade80",
        "teal": "#2dd4bf",
        "sky": "#38bdf8",
        "sapphire": "#60a5fa",
        "warning": "#fbbf24",
