      "color": {
        "bgBase": "#eff1f5",
        "bgMantle": "#e6e9ef",
        "bgCrust": "#dce0e8",
        "bgSurface0": "#ccd0da",
        "bgSurface1": "#bcc0cc",
        "bgSurface2": "#acb0be",
        "bgOverlay0": "#9ca0b0",
        "bgOverlay1": "#8c8fa1",
        "bgOverlay2": "#7c7f93",
        "fgText": "#4c4f69",
        "fgSubtext1": "#505268",
        "fgSubtext0": "#53566e",
        "accent": "#164cc0",
        "accentHover": "#1445b0",
        "accentMuted": "#ccd0da",
        "onAccent": "#ffffff",
        "pink": "#ea76cb",
        "mauve": "#8839ef",
        "red": "#d20f39",
        "peach": "#fe640b",
        "yellow": "#df8e1d",
        "green": "#40a02b",
        "teal": "#179299",
        "sky": "#04a5e5",
