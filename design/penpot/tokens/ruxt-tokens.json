        "success": "#4ade80",
        "info": "#60a5fa",
        "border": "#1a1a1a",
        "borderStrong": "#2e2e2e"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, Geist, system-ui, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "baseSizePx": 16,
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "scale": {
      "caption": { "sizePx": 11, "lineHeight": 1.4, "weight": 500 },
      "label": { "sizePx": 12, "lineHeight": 1.4, "weight": 600 },
      "bodySmall": { "sizePx": 13, "lineHeight": 1.5, "weight": 400 },
      "body": { "sizePx": 14, "lineHeight": 1.55, "weight": 400 },
      "bodyLarge": { "sizePx": 16, "lineHeight": 1.5, "weight": 400 },
      "subtitle": { "sizePx": 18, "lineHeight": 1.4, "weight": 600 },
      "title": { "sizePx": 24, "lineHeight": 1.24, "weight": 700 },
      "heading": { "sizePx": 28, "lineHeight": 1.15, "weight": 700 },
      "display": { "sizePx": 40, "lineHeight": 1.05, "weight": 800 }
    }
  },
  "spacing": { "none": 0, "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "2xl": 20, "3xl": 24, "4xl": 32, "5xl": 40, "6xl": 48 },
  "radius": { "none": 0, "sm": 6, "md": 10, "lg": 16, "full": 9999 },
  "elevation": {
    "none": "none",
    "sm": "0 1px 4px rgb(0 0 0 / 0.18)",
    "md": "0 12px 32px rgb(0 0 0 / 0.35)",
    "lg": "0 20px 60px rgb(0 0 0 / 0.35)",
    "xl": "0 24px 80px rgb(0 0 0 / 0.38)"
  },
  "motion": {
    "durationMs": { "instant": 0, "fast": 150, "standard": 200, "emphasized": 280, "slow": 400, "skeleton": 1200 },
    "easing": { "standard": "ease", "emphasized": "cubic-bezier(0.4, 0, 0.2, 1)", "linear": "linear" },
    "reducedMotion": "Honor prefers-reduced-motion: durations collapse to 0.01ms."
  },
  "breakpoints": {
    "valuesPx": { "phone": 480, "small": 640, "medium": 900 },
    "windowClasses": [
      { "name": "compact", "minWidthPx": 0, "maxWidthPx": 900 },
      { "name": "medium", "minWidthPx": 901, "maxWidthPx": 1279 },
      { "name": "expanded", "minWidthPx": 1280, "maxWidthPx": null }
    ]
  },
  "density": {
    "comfortable": { "scale": 1, "controlHeightPx": 36, "rowHeightPx": 40 },
    "compact": { "scale": 0.875, "controlHeightPx": 30, "rowHeightPx": 32 }
  },
  "focusRing": { "widthPx": 2, "offsetPx": 2, "style": "solid", "colorRole": "accent" },
  "icons": { "set": "lucide", "delivery": "Iconify codes from the local lucide collection, bundled at build time; never fetched at runtime." }
}
