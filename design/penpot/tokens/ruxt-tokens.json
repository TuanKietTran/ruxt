        "success": "#28631b",
        "info": "#135f6d",
        "border": "#ccd0da",
        "borderStrong": "#bcc0cc"
      }
    },
    "opencode": {
      "colorScheme": "dark",
      "color": {
        "bgBase": "#0a0a0a",
        "bgMantle": "#111111",
        "bgCrust": "#050505",
        "bgSurface0": "#1a1a1a",
        "bgSurface1": "#242424",
        "bgSurface2": "#2e2e2e",
        "bgOverlay0": "#404040",
        "bgOverlay1": "#525252",
        "bgOverlay2": "#737373",
        "fgText": "#fafafa",
        "fgSubtext1": "#d4d4d4",
        "fgSubtext0": "#a3a3a3",
        "accent": "#22c55e",
        "accentHover": "#4ade80",
        "accentMuted": "#1a2e1a",
