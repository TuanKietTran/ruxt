# Copy to deploy/celld/.env (gitignored) and fill in. Never commit .env.
# Generate values locally, e.g. MINIO_ROOT_PASSWORD=$(openssl rand -hex 24). Do not print them into logs.
MINIO_ROOT_USER=ruxt-local-admin
MINIO_ROOT_PASSWORD=
# Optional host ports (loopback only). 8787 is reserved for the Pi bridge; 18877/18878 belong to distributed-agent-chat.
RUXT_CELLD_PORT_A=19877
RUXT_CELLD_PORT_B=19878
# Project directory passed to `celld deploy` inside the tools container (must contain wrangler.json).
RUXT_CELLD_PROJECT=/app
# Must be exactly YES to run the deploy service.
CONFIRM_RUXT_CELLD_DEPLOY=NO
