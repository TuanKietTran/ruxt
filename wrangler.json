{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruxt",
  "account_id": "46c2828c378df7fe9f02544b74e296c3",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": true, "persist": true }
  },
  "workers_dev": true,
  "routes": [{ "pattern": "ruxt.mashallow.cloud", "custom_domain": true }],
  "vars": {
    "RUXT_DEPLOYMENT_ENV": "development",
    "CLERK_TELEMETRY_DISABLED": "1"
  },
  "d1_databases": [
    {
      "binding": "RUXT_DB",
      "database_name": "ruxt-dev",
      "database_id": "979c2b6e-a4ec-4f8d-8796-4162dc36b938",
      "migrations_dir": "infra/deploy/cloudflare/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RUXT_KV",
      "id": "62ef57bf79e3482db10e800d2b211510"
    }
  ]
}
