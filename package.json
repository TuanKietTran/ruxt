{
  "name": "ruxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "RUXT_DENO_STORAGE=1 nuxt build",
    "cf:build": "node scripts/build-cloudflare.mjs",
    "cf:deploy:dry": "wrangler deploy --config wrangler.json --dry-run",
    "cf:deploy": "wrangler deploy --config wrangler.json",
    "cf:dev": "wrangler dev --config wrangler.json --local",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "lint": "node scripts/lint-architecture.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "SMOKE_BASE_URL=${SMOKE_BASE_URL:-http://localhost:3000} vitest run tests/smoke",
    "test:session-continuity": "node scripts/check-session-continuity.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "cv:pipeline:setup": "sh scripts/setup-cv-pipeline.sh",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@clerk/nuxt": "3.1.3",
    "@clerk/vue": "2.5.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@iconify-json/lucide": "^1.2.138",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nuxt/icon": "^2.5.1",
    "@ruxt/shared": "0.1.0",
    "@ruxt/core": "file:vendor/tuankiettran-ruxt-core-0.3.0.tgz",
    "@ruxt/editor": "0.1.2",
    "docx": "^9.1.1",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "nuxt": "^4.6.1",
    "playwright-core": "^1.63.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.151.1"
  }
}
