// Canary flavor: same sources as Release, distinct bundle id, display
// name and version suffix, and the canary API origin. The canary host is a
// client build convention only; no separate canary host exists server-side
// (see notes/mobile-contract.md section (h) item 1).
PRODUCT_BUNDLE_IDENTIFIER = cloud.mashallow.ruxt.canary
PRODUCT_NAME = Ruxt
DISPLAY_NAME = Ruxt Canary
MARKETING_VERSION = 1.0.0-canary.1
CURRENT_PROJECT_VERSION = 1
RUXT_API_BASE_URL = https:/$()/ruxt-canary.mashallow.cloud
